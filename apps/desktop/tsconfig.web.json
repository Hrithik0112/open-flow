{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true,
    "paths": {
      "@open-flow/shared": ["../../packages/shared/src/index.ts"],
      "@open-flow/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": [
    "src/renderer/**/*",
    "../../packages/shared/src/**/*"
  ]
}
