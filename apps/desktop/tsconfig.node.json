{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "electron-vite/node"],
    "noEmit": true,
    "paths": {
      "@open-flow/shared": ["../../packages/shared/src/index.ts"],
      "@open-flow/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "electron.vite.config.ts",
    "../../packages/shared/src/**/*"
  ]
}
