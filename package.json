{
  "name": "open-flow",
  "private": true,
  "version": "0.0.0",
  "description": "Local-only macOS dictation. Hold a hotkey, speak, get your transcript injected into the focused field.",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build:sidecar": "bash scripts/build-sidecar.sh",
    "build:desktop": "pnpm --filter @open-flow/desktop build",
    "build": "pnpm build:sidecar && pnpm build:desktop",
    "dev": "pnpm --filter @open-flow/desktop dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  }
}
